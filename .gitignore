.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
data/
*.db
.pytest_cache/
node_modules/
.next/
test-results/
playwright-report/
coverage/
*.tsbuildinfo

web/.shots/

# credentials — never commit
secrets/
*.client_secret*.json
client_secret_*.json
deploy/demo/demo.env

web/.shots-live/

# Design-review artifacts. Regenerated by e2e/design-shots.spec.ts on every run; the repo needs the
# spec that produces them, not 12MB of PNGs that go stale the moment a screen's copy changes.
# `/*` rather than a trailing `/`: git cannot re-include a path under a directory the pattern
# itself excludes, so the exception below needs every entry matched individually.
web/design-shots/*
# Exception: the public demo landing's own shots (e2e-demo/demo.spec.ts). A hand-picked, 14-file
# set kept as evidence for the scoring packet — not the exhaustive, always-regenerated set above.
!web/design-shots/demo/

# The red-team harness writes its runs here; a report is evidence, not source.
redteam/out/
.vercel

# graphify's local code-graph cache; regenerated per machine and never shipped.
graphify-out/

# The mutation runner's crash record: it names the file it is mutating right now and carries the
# bytes to put back. It exists for a fraction of a second per control, and only outlives a run that
# was killed mid-mutation — which is exactly when the next run must find it.
.mutcheck-inflight.json
.mutcheck-inflight.json.tmp

# The restore stages the original bytes beside the file they belong to and `os.replace`s them over
# it, so that an interrupted restore cannot leave a half-original file. A run killed in the
# microsecond between the two leaves the staging file; it is never part of the tree.
*.mutcheck-restore
