{
  "name": "privatemesh-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts --project=desktop && PM_LIVE_API_PORT=8832 PM_LIVE_WEB_PORT=3132 PM_LIVE_GATE_PORT=8834 playwright test --config playwright.live.config.ts --project=phone",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "fonts": "sh scripts/install-fonts.sh",
    "guards": "node scripts/build-guards.mjs --self-test",
    "guard:static-live": "node scripts/assert-build-refuses.mjs",
    "bundle-check": "node scripts/check-bundle.mjs",
    "verify": "npm run guards && npm run guard:static-live && NEXT_PUBLIC_OWNER_TOKEN=pm-owner-token-canary-2f9c npm run build && npm run bundle-check && npm test && npm run e2e"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
